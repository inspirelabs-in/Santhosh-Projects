# =============================================================================
# grabon-intel — dev environment
# Paid services we kept: OpenAI (prod). Free dev: NVIDIA NIM.
# =============================================================================

# Postgres
GRABON_DATABASE_URL=postgresql+asyncpg://grabon:grabon@localhost:5432/grabon

# ---- LLM providers ---------------------------------------------------------
# Dev (free): NVIDIA NIM — signup https://build.nvidia.com
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Prod: OpenAI
OPENAI_API_KEY=

# Optional
ANTHROPIC_API_KEY=

# Optional fully-local dev (install: https://ollama.com)
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_API_KEY=ollama
OLLAMA_VISION_MODEL=llava:13b

# Tier → model id
GRABON_LLM_TIER_CHEAP=nvidia/llama-3.3-70b
GRABON_LLM_TIER_FAST=openai/gpt-4o-mini
GRABON_LLM_TIER_SMART=openai/gpt-4o
GRABON_LLM_TIER_FALLBACK=nvidia/llama-3.1-70b

# ---- SERP: self-hosted SearXNG --------------------------------------------
# Compose: https://docs.searxng.org/admin/installation-docker.html
SEARXNG_URL=http://localhost:8888

# ---- Signals (free) -------------------------------------------------------
META_AD_LIBRARY_TOKEN=
META_AD_LIBRARY_BASE=https://graph.facebook.com/v23.0/ads_archive

# YouTube Data API v3 — free 10K units/day
# Get key: https://console.cloud.google.com/apis/credentials
YOUTUBE_API_KEY=

# ---- CRM (free tier) -----------------------------------------------------
# HubSpot: create private app at https://app.hubspot.com/private-apps/
HUBSPOT_API_KEY=

# ---- Runtime --------------------------------------------------------------
GRABON_LOG_LEVEL=INFO
GRABON_LOG_JSON=false
GRABON_DAILY_COST_CAP_CENTS=500
GRABON_PAUSED=false

# ---- Temporal -------------------------------------------------------------
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=grabon-intel
TEMPORAL_TLS=false

# ---- API gateway ----------------------------------------------------------
GRABON_API_KEYS=devkey1,devkey2
GRABON_API_CORS_ORIGINS=http://localhost:3000

# ---- Notifiers ------------------------------------------------------------
# Teams: channel → Workflows → "Post to a channel when a webhook request is received"
TEAMS_WEBHOOK_URL=

# Email digest (your own SMTP / Office 365 mailbox works)
DIGEST_EMAIL_TO=
DIGEST_SMTP_HOST=
DIGEST_SMTP_PORT=587
DIGEST_SMTP_USER=
DIGEST_SMTP_PASS=
DIGEST_FROM=

# ---- Outbound mailbox (replaces Smartlead) --------------------------------
OUTBOUND_SMTP_HOST=
OUTBOUND_SMTP_PORT=587
OUTBOUND_SMTP_USER=
OUTBOUND_SMTP_PASS=
OUTBOUND_FROM=
OUTBOUND_REPLY_TO=
INBOUND_IMAP_HOST=
INBOUND_IMAP_PORT=993
INBOUND_IMAP_USER=
INBOUND_IMAP_PASS=
INBOUND_IMAP_FOLDER=INBOX

# ---- Observability (optional self-host) -----------------------------------
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3001
