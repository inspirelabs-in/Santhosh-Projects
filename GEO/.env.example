# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/grabon_geo

# Parser LLM provider: groq | openai | gemini
PARSER_PROVIDER=groq

# API keys (at least one parser key required)
GROQ_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# CloudProxy URL for rotating proxies
CLOUDPROXY_URL=

# Teams webhook for critical alerts (optional)
# TEAMS_WEBHOOK_URL=

# Scheduler
CRON_HOUR=0
CRON_MINUTE=0
