# =====================================================================
# GrabOn Hiring Agent -- environment variables.
#
# Copy to .env and fill the values. Never commit .env.
#
# Each section is marked:
#   [REQUIRED]  -- application will not start / function without this.
#   [OPTIONAL]  -- can stay empty; the related feature is gated by a flag.
#   [BOOTSTRAP] -- must live in .env; cannot be edited from the dashboard.
#   [UI]        -- editable from the dashboard at /settings (.env value is
#                  the boot-time default; DB overlay takes precedence).
#
# Once the stack is running, prefer editing [UI] values from the
# dashboard — Settings → pick any section. Run the importer once after
# upgrading to migrate existing .env values into the DB:
#
#   python -m scripts.import_env_to_db
#
# When a value is "AUTO", docker-compose already configures it for you.
# When a value says "GENERATE", run the command shown in the comment.
# =====================================================================

# CONFIG_ENCRYPTION_KEY [BOOTSTRAP, REQUIRED in production]
# Symmetric key used to encrypt secret config values (LLM keys, webhooks,
# SMTP password, etc.) at rest in config_settings. Generate once and never
# change without re-encrypting existing rows:
#   python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
CONFIG_ENCRYPTION_KEY=



# ---------------------------------------------------------------------
# 1. App  [REQUIRED]
# ---------------------------------------------------------------------
APP_ENV=development                   # development | staging | production
APP_BASE_URL=http://localhost:8000    # public URL the agent is reachable at
LOG_LEVEL=INFO
SENTRY_DSN=                           # OPTIONAL: sentry.io -> create FastAPI project -> copy DSN


# ---------------------------------------------------------------------
# 2. Postgres + Redis  [AUTO via docker-compose]
# ---------------------------------------------------------------------
DB_PASSWORD=agent_dev_pw
DATABASE_URL=postgresql+asyncpg://agent:agent_dev_pw@postgres:5432/hiring_agent
DATABASE_URL_SYNC=postgresql+psycopg://agent:agent_dev_pw@postgres:5432/hiring_agent
REDIS_URL=redis://redis:6379/0


# ---------------------------------------------------------------------
# 3. LLM (OpenAI)  [REQUIRED]
#    Where: https://platform.openai.com/api-keys -> Create new secret key
#    Set monthly hard limit at: platform.openai.com/account/limits
# ---------------------------------------------------------------------
OPENAI_API_KEY=                       # sk-... key from OpenAI dashboard
LLM_PROVIDER=openai
# Cheap-only policy. The LLMClient premium-model guard
# (src/llm/client.py::assert_model_allowed),
LLM_MODEL_FAST=openai/gpt-4o-mini
LLM_MODEL_SMART=openai/gpt-4o-mini

# Caps -- enforced in Redis, blocks runaway spend.
LLM_DAILY_CALL_LIMIT=1000
LLM_DAILY_TOKEN_LIMIT=1000000
LLM_PER_CANDIDATE_MONTHLY_LIMIT=40
LLM_RATE_LIMIT_PER_MINUTE=60
LLM_DAILY_BUDGET_USD=5

# Cost tracing  [OPTIONAL]
# Where: docker compose up -d langfuse, then http://localhost:3000 ->
# create project -> Settings -> API Keys -> Create.
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=


# ---------------------------------------------------------------------
# 4. Object storage  [AUTO local MinIO; for prod swap to Cloudflare R2]
#    Where (prod): https://dash.cloudflare.com -> R2 -> Create bucket
#    "hiring-agent-resumes" + "hiring-agent-consent" -> API token
#    "Object Read & Write" -> copy id + secret + endpoint URL.
# ---------------------------------------------------------------------
R2_ENDPOINT_URL=http://minio:9000
R2_PUBLIC_ENDPOINT_URL=http://localhost:9000
R2_ACCESS_KEY_ID=minioadmin
R2_SECRET_ACCESS_KEY=minioadmin
R2_BUCKET_RESUMES=hiring-agent-resumes
R2_BUCKET_CONSENT=hiring-agent-consent
R2_REGION=auto


# ---------------------------------------------------------------------
# 5. Inbound mail (IMAP)  [REQUIRED for email-source candidates]
#    Gmail   -> myaccount.google.com/apppasswords (16-char app password)
#    Outlook -> account.microsoft.com -> Security -> App passwords
#               (host: outlook.office365.com, port 993, source: imap_outlook)
#    OAuth2 -> reuse the GRAPH_* Azure AD app (section 14),
#               source: "imap_outlook_oauth", password field empty.
#    Replace the placeholder password; keep the JSON shape.
# ---------------------------------------------------------------------
MAIL_INBOXES=[{"label":"careers","host":"imap.gmail.com","port":993,"user":"careers@grabon.in","password":"REPLACE_WITH_APP_PASSWORD","source":"imap_gmail","folder":"INBOX"}]
# Production Outlook example:
# MAIL_INBOXES=[{"label":"careers-outlook","host":"outlook.office365.com","port":993,"user":"careers@grabon.in","password":"OUTLOOK_APP_PASSWORD","source":"imap_outlook","folder":"INBOX"}]
MAIL_POLL_INTERVAL_SECONDS=60
MAIL_MAX_MESSAGES_PER_POLL=25


# ---------------------------------------------------------------------
# 6. Outbound email  [REQUIRED]
#    EMAIL_PROVIDER selects the sender. "auto" picks first configured:
#       1. Microsoft Graph /sendMail -- preferred for M365 (reuses GRAPH_*).
#          Add Mail.Send application permission + admin consent.
#       2. Resend HTTPS API.
#       3. SMTP (Outlook smtp.office365.com:587 STARTTLS / MailHog / SES).
#
#    Dev: leave EMAIL_PROVIDER=auto, no creds -> MailHog at :8025.
#    Prod: EMAIL_PROVIDER=graph + fill GRAPH_* below in section 14.
# ---------------------------------------------------------------------
EMAIL_PROVIDER=auto                   # auto | graph | resend | smtp

RESEND_API_KEY=                       # re_... (legacy / non-M365 only)
RESEND_FROM_EMAIL=careers@grabon.in
RESEND_FROM_NAME="GrabOn Careers"
RESEND_REPLY_TO=careers@grabon.in

SMTP_HOST=mailhog                     # AUTO via docker-compose
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=false
# Production Outlook SMTP example:
# SMTP_HOST=smtp.office365.com
# SMTP_PORT=587
# SMTP_USER=careers@grabon.in
# SMTP_PASSWORD=OUTLOOK_APP_PASSWORD
# SMTP_USE_TLS=true

# Landing-page lead capture. Enquiries from the public site are emailed here.
# Leave blank to disable the form (the site hides it automatically).
LEADS_EMAIL=


# ---------------------------------------------------------------------
# 7. Dashboard auth + security  [REQUIRED -- generate the secrets]
#
#    JWT_SIGNING_SECRET (64-char random):
#      python -c "import secrets; print(secrets.token_urlsafe(48))"
#
#    DASHBOARD_KEYS -- one key per HR user, prefixed admin_/rec_/view_.
#    Generate each:
#      python -c "import secrets; print('admin_' + secrets.token_urlsafe(24))"
#      python -c "import secrets; print('rec_'   + secrets.token_urlsafe(24))"
#      python -c "import secrets; print('view_'  + secrets.token_urlsafe(24))"
#    Then paste a JSON map below.
# ---------------------------------------------------------------------
DASHBOARD_KEYS={"admin_REPLACE_ME":"admin","rec_REPLACE_ME":"recruiter","view_REPLACE_ME":"viewer"}
JWT_SIGNING_SECRET=REPLACE_WITH_RANDOM_64_CHAR_STRING
JWT_ISSUER=hiring-agent
SCREENING_URL_TTL_DAYS=14


# ---------------------------------------------------------------------
# 8. Compliance (DPDP)  [REQUIRED]
# ---------------------------------------------------------------------
DATA_RETENTION_DAYS_DEFAULT=180
DATA_RETENTION_DAYS_TALENT_POOL=540
DPO_CONTACT_EMAIL=dpo@grabon.in


# ---------------------------------------------------------------------
# 8b. Submission enrichment  [OPTIONAL]
#     GitHub token raises API rate limit from 60/hr to 5000/hr.
#     Loom API key enables video transcript fetching.
# ---------------------------------------------------------------------
GITHUB_TOKEN=                             # ghp_... (Personal Access Token, public_repo scope)
LOOM_API_KEY=                             # from https://developer.loom.com


# =====================================================================
# Agentic V2 -- everything below is gated by a feature flag.
# Flip a flag only after the matching keys land below.
# =====================================================================


# ---------------------------------------------------------------------
# 9. Feature flags  [REQUIRED -- defaults are safe]
# ---------------------------------------------------------------------
ENABLE_VOICE_SCREENING=false          # turn on after section 11
ENABLE_ASSESSMENT_ROUND=false         # turn on after section 12
ENABLE_MEETING_ANALYSIS=false         # turn on after section 13
ENABLE_CEO_DASHBOARD=false


# ---------------------------------------------------------------------
# 10. Arq worker  [RECOMMENDED -- enable for precise scheduling]
#     When false, scheduled callbacks fall back to a coarse poller.
# ---------------------------------------------------------------------
ARQ_ENABLED=true
ARQ_QUEUE_NAME=hiring-agent
ARQ_MAX_JOBS=10
ARQ_CALLBACK_POLL_INTERVAL_SECONDS=60


# ---------------------------------------------------------------------
# 11. Voice screen -- ElevenLabs Conversational AI  [OPTIONAL]
#
#     What it unlocks: outbound AI phone screens, confirmation calls
#     for interviews, automatic callback rescheduling.
#
#     1. Sign up: https://elevenlabs.io/sign-up (Pro plan needed for
#        Conversational AI).
#     2. Settings -> API Keys -> Create -> ELEVENLABS_API_KEY.
#     3. Conversational AI -> Create Agent ("GrabOn Hiring Screener")
#        -> save -> ELEVENLABS_AGENT_ID.
#     4. In the agent: Phone numbers -> Add -> Twilio -> paste your
#        Twilio Account SID + Auth Token + an owned number ->
#        ElevenLabs returns ELEVENLABS_PHONE_NUMBER_ID.
#        (Twilio: https://www.twilio.com/console -> buy a number with
#         Voice + outbound SMS capability.)
#     5. Settings -> Webhooks -> Add ->
#        https://<your-public-host>/webhooks/voice/elevenlabs ->
#        events: post_call_transcription, post_call_audio,
#        conversation_started -> copy signing secret ->
#        ELEVENLABS_WEBHOOK_SECRET.
#     6. Flip ENABLE_VOICE_SCREENING=true above.
# ---------------------------------------------------------------------
VOICE_PROVIDER=elevenlabs
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
ELEVENLABS_PHONE_NUMBER_ID=
ELEVENLABS_WEBHOOK_SECRET=

VOICE_AGENT_COMPANY_NAME=GrabOn
VOICE_AGENT_MAX_CALL_SECONDS=1200
VOICE_AGENT_MAX_QUESTIONS=5
VOICE_AGENT_PASS_THRESHOLD=65
VOICE_AGENT_MAX_CALLBACK_ATTEMPTS=3
VOICE_AGENT_MAX_NOANSWER_ATTEMPTS=3
VOICE_AGENT_NOANSWER_BACKOFF_SECONDS=1800

# Quiet-hours guard. Outbound calls (initial dial, no-answer retries,
# candidate-requested callbacks) are clamped into this window. Defaults
# = 11:00-20:00 IST, weekdays + weekends. Times are inclusive-start,
# exclusive-end. Set SKIP_WEEKENDS=true to also avoid Sat/Sun.
VOICE_CALL_WINDOW_START_HOUR=11
VOICE_CALL_WINDOW_END_HOUR=20
VOICE_CALL_WINDOW_TZ=Asia/Kolkata
VOICE_CALL_SKIP_WEEKENDS=false


# ---------------------------------------------------------------------
# 12. Assessments -- Predictive Index Cognitive  [OPTIONAL]
#
#     What it unlocks: when a candidate clears the voice phone screen,
#     the agent emails them a static PI Cognitive Assessment link.
#
#     There is NO PI API integration. HR pastes the static cognitive
#     link onto each role at creation time (Role form > "PI Cognitive
#     link" field, or via the conversational agent draft). Roles with
#     an empty link skip the courtesy email entirely and proceed to
#     the next pipeline step.
#
#     To enable: just flip ENABLE_ASSESSMENT_ROUND=true above. No keys
#     or webhook secrets are required.
# ---------------------------------------------------------------------


# ---------------------------------------------------------------------
# 13. Meeting bot -- Read.ai (calendar-trigger)  [OPTIONAL]
#
#     What it unlocks: AI notetaker auto-joins Teams technical + CEO
#     interviews via Read.ai's calendar OAuth, returns transcript +
#     recording, agent scores them.
#
#     Read.ai has NO bot-dispatch API -- it joins meetings sitting on
#     the connected organiser calendar automatically.
#
#     1. https://read.ai -> Workspace -> Integrations -> connect the
#        Microsoft 365 / Google Calendar of the organiser mailbox you
#        use for interviews (typically careers@grabon.in).
#     2. Settings -> Developer -> API Keys -> Create -> READ_AI_API_KEY.
#     3. Settings -> Developer -> Webhooks -> Add ->
#        https://<your-public-host>/webhooks/meeting/readai
#        -> events: meeting.completed, report.completed
#        -> copy signing secret -> READ_AI_WEBHOOK_SECRET.
#     4. READ_AI_ORGANISER_EMAIL = mailbox connected in step 1.
#     5. Flip ENABLE_MEETING_ANALYSIS=true above.
# ---------------------------------------------------------------------
MEETING_BOT_PROVIDER=readai                # readai | recall | graph

READ_AI_API_KEY=
READ_AI_BASE_URL=https://api.read.ai/v1
READ_AI_WEBHOOK_SECRET=
READ_AI_ORGANISER_EMAIL=
READ_AI_POLL_DELAY_SECONDS=4200            # poll fallback: 70 min after start
READ_AI_POLL_MAX_ATTEMPTS=12
READ_AI_POLL_INTERVAL_SECONDS=300

# Recall.ai legacy (only used when MEETING_BOT_PROVIDER=recall).
RECALL_AI_API_KEY=
RECALL_AI_BASE_URL=https://us-east-1.recall.ai/api/v1
RECALL_AI_WEBHOOK_SECRET=
RECALL_BOT_DISPLAY_NAME="GrabOn AI Notetaker"
RECALL_BOT_JOIN_LEAD_SECONDS=120

GRAPH_TRANSCRIPTS_ENABLED=false            # OPTIONAL: Teams Premium / E3+ only


# ---------------------------------------------------------------------
# 14. Microsoft Graph -- AI auto-scheduling  [OPTIONAL]
#
#     What it unlocks: agent picks slot, books a real Teams meeting,
#     emails panel + candidate, calls candidate to confirm.
#
#     1. Azure portal: https://portal.azure.com -> Microsoft Entra ID
#        -> App registrations -> New registration ("GrabOn Hiring
#        Agent"). Save -> note Application (client) ID + Directory
#        (tenant) ID.
#        -> GRAPH_CLIENT_ID, GRAPH_TENANT_ID.
#     2. The app -> Certificates & secrets -> New client secret ->
#        GRAPH_CLIENT_SECRET (1 or 2 year expiry).
#     3. The app -> API permissions -> Add a permission ->
#        Microsoft Graph -> Application permissions:
#          - OnlineMeetings.ReadWrite.All
#          - Calendars.Read.All
#          - Mail.Send                  (REQUIRED for EMAIL_PROVIDER=graph)
#          - Mail.ReadWrite             (only if using IMAP-OAuth path)
#        -> click "Grant admin consent for <tenant>".
#     4. Decide which mailbox the agent organises meetings under
#        (the user's calendar must be readable by app permissions).
#        -> GRAPH_ORGANISER_EMAIL (e.g. careers@grabon.in).
#     5. Enable scheduling on each role from the role-form UI.
# ---------------------------------------------------------------------
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_ORGANISER_EMAIL=careers@grabon.in
