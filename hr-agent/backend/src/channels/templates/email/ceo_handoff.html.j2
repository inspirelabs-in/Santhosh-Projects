{%- import "_macros.html.j2" as ui with context -%}
{%- set subject = "CEO review: " ~ (candidate_name or "candidate") ~ " — " ~ (role_title or "role") -%}
{{ ui.page_open() }}
{% include "_header.html.j2" %}
{{ ui.card_open() }}
  {{ ui.eyebrow("CEO review — pending decision") }}
  {{ ui.hero_title((candidate_name or "Candidate") ~ " has cleared technical review") }}

  <div style="font-family:{{ brand.font_stack }};font-size:15px;line-height:1.6;color:{{ brand.ink }};">
    <p>The technical panel has approved <strong>{{ candidate_name or "this candidate" }}</strong> for the <strong>{{ role_title or "role" }}</strong> position.</p>

    {% if tech_decision_actor %}
      <p style="color:{{ brand.muted_text }};">Approved by: <strong>{{ tech_decision_actor }}</strong>{% if tech_decision_note %} — "{{ tech_decision_note }}"{% endif %}</p>
    {% endif %}

    {% if fit_score is not none %}
      <p>Agent fit score: <strong>{{ fit_score }}/100</strong>{% if fit_tier %} &middot; tier <strong>{{ fit_tier }}</strong>{% endif %}</p>
    {% endif %}

    <p style="margin-top:12px;">Please review the candidate's full journey on the CEO dashboard — resume, screening Q&amp;A, assignment artifacts, journey report, and any voice/technical interview transcripts. Then either:</p>
    <ul style="margin:8px 0 8px 20px;padding:0;color:{{ brand.ink }};">
      <li><strong>Advance to HR meeting</strong> — locks the candidate for the final HR round.</li>
      <li><strong>Reject</strong> — closes the application with a polite rejection email.</li>
    </ul>
  </div>

  {% if review_url %}
    {{ ui.cta_button(review_url, "Open CEO dashboard") }}
    {{ ui.fallback_link(review_url) }}
  {% endif %}

  {{ ui.signoff(name=company_name ~ " Hiring Agent") }}
  {{ ui.reference_line(application_id) }}
{{ ui.card_close() }}
{% include "_footer.html.j2" %}
{{ ui.page_close() }}
