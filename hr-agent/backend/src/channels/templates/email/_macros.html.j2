{# Reusable building blocks for branded emails.
   Inline styles only -- email clients are unforgiving with <style> blocks.
   Text macros render with the ``safe`` filter so callers can pass small
   inline HTML fragments through. Activity layer must build these strings
   from trusted values only. #}

{%- macro page_open() -%}
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>GrabOn Hiring</title>
    {# Try to load Nunito Sans where the client supports remote fonts.
       Gmail strips <link>; Apple Mail / Outlook for Mac honour it. We
       always fall back to the system stack defined in brand.font_stack. #}
    <link href="{{ brand.google_font_url }}" rel="stylesheet" />
  </head>
  <body style="margin:0;padding:0;background:{{ brand.surface }};
    font-family:{{ brand.font_stack }};color:{{ brand.ink }};">
{%- endmacro -%}

{%- macro page_close() -%}
  </body>
</html>
{%- endmacro -%}

{%- macro card_open() -%}
<table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%"
  style="background:{{ brand.surface }};">
  <tr>
    <td align="center" style="padding:0 16px 32px 16px;">
      <table role="presentation" cellpadding="0" cellspacing="0" border="0"
        width="100%" style="max-width:560px;background:#ffffff;border-radius:12px;
        border:1px solid {{ brand.border }};overflow:hidden;">
        <tr>
          <td style="padding:32px 32px 28px 32px;font-family:{{ brand.font_stack }};
            font-size:15px;line-height:1.6;color:{{ brand.ink }};">
{%- endmacro -%}

{%- macro card_close() -%}
          </td>
        </tr>
      </table>
    </td>
  </tr>
</table>
{%- endmacro -%}

{%- macro hero_title(text) -%}
<h1 style="margin:0 0 12px 0;font-family:{{ brand.font_stack }};font-size:24px;
  font-weight:800;letter-spacing:-0.01em;color:{{ brand.ink }};line-height:1.2;">
  {{ text | safe }}
</h1>
{%- endmacro -%}

{%- macro eyebrow(text) -%}
<p style="margin:0 0 18px 0;font-family:{{ brand.font_stack }};font-size:11px;
  font-weight:700;letter-spacing:2px;text-transform:uppercase;color:{{ brand.primary }};">
  {{ text | safe }}
</p>
{%- endmacro -%}

{%- macro paragraph(text) -%}
<p style="margin:0 0 14px 0;font-family:{{ brand.font_stack }};font-size:15px;
  line-height:1.6;color:{{ brand.ink }};">{{ text }}</p>
{%- endmacro -%}

{%- macro highlight_box(text, accent="primary") -%}
{%- set color = brand.primary if accent == "primary" else (brand.info if accent == "info" else brand.primary_light) -%}
<table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%"
  style="margin:18px 0;">
  <tr>
    <td style="background:{{ brand.surface }};border-left:3px solid {{ color }};
      padding:14px 16px;font-family:{{ brand.font_stack }};font-size:14px;
      color:{{ brand.ink }};border-radius:4px;line-height:1.5;">
      {{ text | safe }}
    </td>
  </tr>
</table>
{%- endmacro -%}

{%- macro cta_button(href, label, accent="primary") -%}
{%- set color = brand.primary if accent == "primary" else brand.info -%}
<table role="presentation" cellpadding="0" cellspacing="0" border="0"
  style="margin:18px 0 6px 0;">
  <tr>
    <td bgcolor="{{ color }}" style="border-radius:8px;">
      <a href="{{ href }}" target="_blank" rel="noopener"
        style="display:inline-block;padding:12px 22px;font-family:{{ brand.font_stack }};
        font-size:14px;font-weight:700;color:#ffffff;text-decoration:none;
        border-radius:8px;letter-spacing:0.2px;">
        {{ label }}
      </a>
    </td>
  </tr>
</table>
{%- endmacro -%}

{%- macro fallback_link(href) -%}
<p style="margin:8px 0 18px 0;font-family:{{ brand.font_stack }};font-size:12px;
  color:{{ brand.muted_text }};line-height:1.5;">
  If the button doesn’t work, paste this into your browser:<br/>
  <a href="{{ href }}" style="color:{{ brand.info }};word-break:break-all;">{{ href }}</a>
</p>
{%- endmacro -%}

{%- macro reference_line(application_id) -%}
<p style="margin:24px 0 0 0;font-family:{{ brand.font_stack }};font-size:11px;
  color:{{ brand.muted_text }};letter-spacing:0.3px;">
  Reference: <span style="font-variant-numeric:tabular-nums;">{{ application_id }}</span>
</p>
{%- endmacro -%}

{%- macro signoff(name="GrabOn Talent Acquisition") -%}
<p style="margin:22px 0 0 0;font-family:{{ brand.font_stack }};font-size:14px;
  color:{{ brand.ink }};">
  Best,<br/>
  <strong>{{ name }}</strong>
</p>
{%- endmacro -%}
