{%- import "_macros.html.j2" as ui with context -%}
{%- set subject = "Pick an interview slot for " ~ role_title ~ " at GrabOn" -%}
{{ ui.page_open() }}
{% include "_header.html.j2" %}
{{ ui.card_open() }}
  {{ ui.eyebrow("Slot proposal") }}
  {{ ui.hero_title("Hi " ~ (candidate_name or "there") ~ ", let's book a time.") }}
  {{ ui.paragraph("We'd like to invite you to interview for the <strong>" ~ role_title ~ "</strong> role. Pick whichever slot works best -- click the link to book it.") }}

  <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" style="margin:8px 0 16px 0;">
    {% for slot in slots %}
      <tr>
        <td style="padding:6px 0;">
          <a href="{{ booking_base_url }}?slot={{ slot.slot_token }}"
            style="display:inline-block;padding:10px 16px;border:1px solid {{ brand.border }};
            background:{{ brand.surface }};border-radius:8px;font-family:{{ brand.font_stack }};
            font-size:14px;color:{{ brand.ink }};text-decoration:none;font-weight:600;">
            {{ slot.display }}
          </a>
        </td>
      </tr>
    {% endfor %}
  </table>

  {{ ui.paragraph("If none of these work, reply to this email and we'll propose fresh times.") }}

  <p style="margin:6px 0 0 0;font-family:{{ brand.font_stack }};font-size:12px;color:{{ brand.muted_text }};">
    All times in IST. Interviews run for {{ duration_minutes }} minutes.
  </p>

  {{ ui.signoff() }}
{{ ui.card_close() }}
{% include "_footer.html.j2" %}
{{ ui.page_close() }}
