{%- import "_macros.html.j2" as ui with context -%}
{%- set subject = "Interview confirmed: " ~ role_title ~ " at GrabOn" -%}
{{ ui.page_open() }}
{% include "_header.html.j2" %}
{{ ui.card_open() }}
  {{ ui.eyebrow("Interview confirmed") }}
  {{ ui.hero_title("Hi " ~ (candidate_name or "there") ~ ", you are booked.") }}
  {{ ui.paragraph("Your interview for the <strong>" ~ role_title ~ "</strong> role at GrabOn is confirmed.") }}
  {{ ui.highlight_box("<strong>When:</strong> " ~ scheduled_display ~ " (IST)<br/><strong>Duration:</strong> " ~ duration_minutes ~ " minutes" ~ ("<br/><strong>Join:</strong> <a style='color:" ~ brand.info ~ ";' href='" ~ meeting_link ~ "'>" ~ meeting_link ~ "</a>" if meeting_link else ""), accent="primary") }}
  {% if meeting_link %}
    {{ ui.cta_button(meeting_link, "Join Teams meeting", accent="primary") }}
  {% endif %}
  {{ ui.paragraph("A calendar invite will follow. If you need to reschedule, reply to this email.") }}
  {{ ui.signoff() }}
{{ ui.card_close() }}
{% include "_footer.html.j2" %}
{{ ui.page_close() }}
