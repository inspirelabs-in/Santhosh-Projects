{%- import "_macros.html.j2" as ui with context -%}
{%- set subject = "Reminder: assignment due soon · " ~ role_title -%}
{{ ui.page_open() }}
{% include "_header.html.j2" %}
{{ ui.card_open() }}
  {{ ui.eyebrow("Assignment reminder") }}
  {{ ui.hero_title("Hi " ~ (candidate_name or "there") ~ ", your assignment is due soon.") }}
  {{ ui.paragraph("Just a friendly reminder that the take-home assignment for the <strong>" ~ role_title ~ "</strong> role is due in approximately <strong>" ~ hours_remaining ~ " hours</strong>.") }}
  {{ ui.highlight_box("<strong>Deadline:</strong> " ~ deadline, accent="primary") }}

  <p style="margin:18px 0 0 0;font-family:{{ brand.font_stack }};font-size:14px;color:{{ brand.ink }};line-height:1.6;">
    If you need more time or have questions about the assignment, please
    reply to this email.
  </p>

  {{ ui.signoff() }}
{{ ui.card_close() }}
{% include "_footer.html.j2" %}
{{ ui.page_close() }}
