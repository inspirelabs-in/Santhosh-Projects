# =====================================================================
# Emotion service -- environment variables
# =====================================================================

LOG_LEVEL=INFO
BIND_HOST=0.0.0.0
BIND_PORT=8090

# Bearer token shared with the hiring-agent backend.
EMOTION_API_KEY=

# HF model id. Override with a fine-tuned model + HF_TOKEN if private.
EMOTION_MODEL_ID=ehcalabres/wav2vec2-lg-xlsr-en-speech-emotion-recognition
HF_TOKEN=

MAX_AUDIO_MB=60
MAX_AUDIO_SECONDS=1800
